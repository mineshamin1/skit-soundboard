 "lines": [
  {
   "speaker": "",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "cue",
     "n": 1
    }
   ]
  },
  {
   "speaker": "NARRATOR",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Deviyon aur Sajjano!!! Aaj hum aapko le jaate hain ek adbhut gaon, Ghoomerabad ki anokhi Paathshaala, Guru Gul, mein, jahaan unke sarvashreshth Guruji bachchon ko gyaan baantne ki bharpoor koshish karte hain.Guruji chale hain bacchon ko Einstein banaane magar ye chhaatra to Gobar mera matlab hai Gabbar ke baap hain!!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Bachchon, aap log homework ki taiyaari karke aaye ho? Aaj main aapko kuch General Knowledge, yaane Saamaanya Gyaan, ke prashna poochhunga aur aapka homework check karunga."
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Aaj ek naya student aata hai kaksha mein."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "What is your name?"
    }
   ]
  },
  {
   "speaker": "SUNDER",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Mera naam Sundar Lal Chadha hai."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "If I ask a question in English, please answer in English."
    }
   ]
  },
  {
   "speaker": "SUNDER",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Sir, my name is Beautiful Red Underwear!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Ha ha ha ha"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "What nonsense!!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Why are you transferring in middle of year?"
    }
   ]
  },
  {
   "speaker": "SUNDER",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "my father got job transfer from Under Water to Roaming City"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Kya bakwaas hai yeh!!"
    }
   ]
  },
  {
   "speaker": "SUNDER",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Mere pyon da tabaadla hua Jalandhar se Ghoomerabad!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "cue",
     "n": 2
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 1,
   "segments": [
    {
     "type": "text",
     "text": "Shut up and sit down"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Arre Lakhan, tumne homework kyun nahi kiya?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, light chali gayi thi."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Toh mombatti jalaa lete?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, maachis nahi thi."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Kyun, maachis kyun nahi thi?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, pooja ghar mein rakhi thi."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Toh pooja ghar se le lete!"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, nahaaya nahi tha."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Ab ye nahaaye kyun nahi the?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, paani nahi tha."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Arre, paani kyun nahi tha?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, motor nahi chal rahi thi."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Arre yaar, ye kambakht motor kyun nahi chal rahi thi?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Sir, kitni baar bataun ki light hi nahi thi!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "cue",
     "n": 3
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "text",
     "text": "Chup nalaayak! Baith jao!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 2,
   "segments": [
    {
     "type": "cue",
     "n": 4
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 3,
   "segments": [
    {
     "type": "text",
     "text": "Achha Kalaam, tum batao mujhe ki ek taraf paisa ho aur doosri taraf akal, toh tum kya loge?"
    }
   ]
  },
  {
   "speaker": "KALAAM",
   "note": "",
   "scene": 3,
   "segments": [
    {
     "type": "text",
     "text": "Sir, main toh paisa hi chununga."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 3,
   "segments": [
    {
     "type": "text",
     "text": "Galat! Agar main tumhaari jagah hota, toh akal chunta."
    }
   ]
  },
  {
   "speaker": "KALAAM",
   "note": "",
   "scene": 3,
   "segments": [
    {
     "type": "text",
     "text": "Theek kaha, sir, aapne. Jiske paas"
    }
   ]
  },
  {
   "speaker": "CLASS",
   "note": "",
   "scene": 3,
   "segments": []
  },
  {
   "speaker": "",
   "note": "",
   "scene": 3,
   "segments": [
    {
     "type": "cue",
     "n": 5
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "text",
     "text": "(Alok is snoring and Guruji startles him) Alok, tum khade ho jao. Ye batao, kaunsa pakshi sabse tez udta hai?"
    }
   ]
  },
  {
   "speaker": "ALOK",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "text",
     "text": "Sir, ghoda!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "text",
     "text": "Chup badmaash! Ye sikhaaya hai tumhaare maa baap ne!!Tere papa kya karte hain?"
    }
   ]
  },
  {
   "speaker": "ALOK",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "text",
     "text": "Sir, mera baap Lawrence Bishnoi gang me shooter hai."
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "cue",
     "n": 6
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "text",
     "text": "La.. la..la..la..l Lawrence Bishnoi!!   Bilkul Sahi jawaab.. Bachchon, likho, ghoda sabse tez pakshi hai!"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "text",
     "text": "Fhaat gayi na …."
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 4,
   "segments": [
    {
     "type": "cue",
     "n": 7
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "text",
     "text": "Achha beta Chatur"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "cue",
     "n": 8
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "text",
     "text": "ek baat toh batao. Kisi scientist ka naam bolo."
    }
   ]
  },
  {
   "speaker": "CHATUR",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "text",
     "text": "Sir, Alia Bhatt!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "text",
     "text": "What nonsense! Ye sikhaata hoon main tumhein?"
    }
   ]
  },
  {
   "speaker": "ALOK",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "text",
     "text": "Nahi, nahi, sir. Ye toh bachpan se hi totla hai. Iska matlab hai Arya Bhatt!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 5,
   "segments": [
    {
     "type": "text",
     "text": "Achha, achha! Theek hai, theek hai. Baith jao."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "text",
     "text": "Achha Chatur, tum mujhe ye batao ki 1869 mein kya hua tha?"
    }
   ]
  },
  {
   "speaker": "CHATUR",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "text",
     "text": "Sir, Gandhiji ka janam hui thi."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "text",
     "text": "Shabaash, shabaash! Bilkul sahi! Achha, ek baat aur batao, 1889 mein kya hua tha?"
    }
   ]
  },
  {
   "speaker": "CHATUR",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "text",
     "text": "Sir, Gandhiji bees saal ke ho gayi thi!"
    }
   ]
  },
  {
   "speaker": "CLASS",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "text",
     "text": "Ha ha ha ha!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "cue",
     "n": 9
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 6,
   "segments": [
    {
     "type": "text",
     "text": "Shut up.. 1889 mein Pandit Nehru ka janam hua tha"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 7,
   "segments": [
    {
     "type": "text",
     "text": "Dekho bachchon, jo apni baat doosron ko samjha na sake, woh gadha hota hai."
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 7,
   "segments": [
    {
     "type": "text",
     "text": "Sir, kya matlab? Mujhe kuch samajh nahi aaya!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 7,
   "segments": [
    {
     "type": "cue",
     "n": 10
    }
   ]
  },
  {
   "speaker": "CLASS",
   "note": "",
   "scene": 7,
   "segments": [
    {
     "type": "text",
     "text": "Ha ha ha ha!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "text",
     "text": "Accha bacchon, Hindi vyakaran mein kitne prakaar ke kaal hote hain?"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "cue",
     "n": 11
    }
   ]
  },
  {
   "speaker": "SUNDAR",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "text",
     "text": "Chaar"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "text",
     "text": "Chaar kahaan se paida huye?? Sirf teen hote hain."
    }
   ]
  },
  {
   "speaker": "SUNDAR",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "text",
     "text": "Naa Sirji, chaar hunde hain"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "text",
     "text": "Accha bataao to zaraa"
    }
   ]
  },
  {
   "speaker": "SUNDAR",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "text",
     "text": "Bhoot kaal.. Vartamaan kaal… Bhavishya kaal…. aur…Sat Sri Akaaal!!!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 8,
   "segments": [
    {
     "type": "cue",
     "n": 12
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 9,
   "segments": [
    {
     "type": "text",
     "text": "Achha bachchon, main tumhe ek baat bataun. Delhi mein Qutub Minar hai"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 9,
   "segments": [
    {
     "type": "text",
     "text": "Achha Alsi Kumar, batao, main kya keh raha tha?"
    }
   ]
  },
  {
   "speaker": "ALSI KUMAR",
   "note": "",
   "scene": 9,
   "segments": [
    {
     "type": "text",
     "text": "Sir, aap keh rahe the ki Delhi mein kutta beemaar hai!"
    }
   ]
  },
  {
   "speaker": "CLASS",
   "note": "",
   "scene": 9,
   "segments": []
  },
  {
   "speaker": "",
   "note": "",
   "scene": 9,
   "segments": [
    {
     "type": "cue",
     "n": 13
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 9,
   "segments": [
    {
     "type": "text",
     "text": "accha accha let jao.. mera matla. Baith jao"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "Achha Kaleshi beta, A ke baad kya aata hai?"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "cue",
     "n": 14
    }
   ]
  },
  {
   "speaker": "KALESHI",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "Guruji, A ke baad... Aaa kya bolti tu?"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "Abey Sun"
    }
   ]
  },
  {
   "speaker": "KALESHI",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "Suna"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "Aati Kya Khandala"
    }
   ]
  },
  {
   "speaker": "ALL KIDS",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "ghoomenge phirenge nachenge gaenge aish karenge aur kya"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 10,
   "segments": [
    {
     "type": "text",
     "text": "chup nalaayakon.. Jab dekho tab nautanki karte rehte ho"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "text",
     "text": "Kaleshi, toh phir ye batao, Tamso Maa Jyotirgamaya ka kya matlab hai"
    }
   ]
  },
  {
   "speaker": "KALESHI",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "text",
     "text": "Guruji iska matlab manne lagta hai ki yeh hai “ Tu So Maa.. Manne jyoti ko ghuma ke aan de”"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "cue",
     "n": 15
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "text",
     "text": "Baith ja Nikamme.. Iska matlab hai “ Hummein Andhkar se Roshni ki taraf le jao”"
    }
   ]
  },
  {
   "speaker": "CHATUR",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "text",
     "text": "Saar yek pe rehena, ya to Jyoti bolna ya phir Roshni bolna…"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "cue",
     "n": 16
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 11,
   "segments": [
    {
     "type": "text",
     "text": "shut up idiot!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 12,
   "segments": [
    {
     "type": "text",
     "text": "Arre haan beta Kalaam, mera honhaar bachcha! Tum sabhi mein ye sabse adhik hoshiyaar hai. Achha beta, tum mujhe ye batao ki import aur export mein kya fark hota hai?"
    }
   ]
  },
  {
   "speaker": "KALAAM",
   "note": "",
   "scene": 12,
   "segments": [
    {
     "type": "text",
     "text": "Sir, import ka matlab…. Sonia Gandhi aur export ka matlab… Sania Mirza!"
    }
   ]
  },
  {
   "speaker": "CLASS",
   "note": "",
   "scene": 12,
   "segments": []
  },
  {
   "speaker": "",
   "note": "",
   "scene": 12,
   "segments": [
    {
     "type": "cue",
     "n": 17
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 13,
   "segments": [
    {
     "type": "text",
     "text": "Koi nahi! Ye batao ki mrityu ke baad Yamraj tumhein agar swarg ya nark jaane ka poochhe, toh tum kya chunoge?"
    }
   ]
  },
  {
   "speaker": "KALAAM",
   "note": "",
   "scene": 13,
   "segments": [
    {
     "type": "text",
     "text": "Sir, main Yamraj se kehke phone aur data plan arrange kar lunga . Phir main kahin bhi settle ho jaaunga!"
    }
   ]
  },
  {
   "speaker": "CLASS",
   "note": "",
   "scene": 13,
   "segments": []
  },
  {
   "speaker": "",
   "note": "",
   "scene": 13,
   "segments": [
    {
     "type": "cue",
     "n": 18
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 13,
   "segments": [
    {
     "type": "text",
     "text": "Beda gark!!!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 14,
   "segments": [
    {
     "type": "text",
     "text": "Lakhan, ye batao, Darjeeling kahaan hai?"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 14,
   "segments": [
    {
     "type": "text",
     "text": "Sir, pata nahi."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 14,
   "segments": [
    {
     "type": "text",
     "text": "Pata nahi?! Kursi pe khade ho jao!"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "",
   "scene": 14,
   "segments": [
    {
     "type": "text",
     "text": "Sir, yahaan se bhi nahi dikh raha, kahaan hai!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 14,
   "segments": [
    {
     "type": "cue",
     "n": 19
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 15,
   "segments": [
    {
     "type": "text",
     "text": "Chatur, What is the chemical formula of water?"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 15,
   "segments": [
    {
     "type": "cue",
     "n": 20
