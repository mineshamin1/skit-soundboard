   ]
  },
  {
   "speaker": "CHATUR",
   "note": "",
   "scene": 15,
   "segments": [
    {
     "type": "text",
     "text": "HIJKLMNO!"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 15,
   "segments": [
    {
     "type": "text",
     "text": "Ye kya bakwaas hai?"
    }
   ]
  },
  {
   "speaker": "CHATUR",
   "note": "",
   "scene": 15,
   "segments": [
    {
     "type": "text",
     "text": "Sir, aapne hi toh kal boli thi H-to-O!"
    }
   ]
  },
