     "type": "cue",
     "n": 21
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 15,
   "segments": [
    {
     "type": "text",
     "text": "Baith jao waapas namakul"
    }
   ]
  },
