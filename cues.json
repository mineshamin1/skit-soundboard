   "speaker": "GURUJI",
   "note": "",
   "scene": 16,
   "segments": [
    {
     "type": "text",
     "text": "Angrez kis shatabdi mein Bharat aaye the?"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 16,
   "segments": [
