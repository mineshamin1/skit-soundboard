   "speaker": "KALESHI",
   "note": "",
   "scene": 16,
   "segments": [
    {
     "type": "text",
     "text": "Sir, woh toh manne nahi patta, par kal nau baje ki shatabdi mein do Angrez choria dekhi gaye the!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 16,
   "segments": [
    {
     "type": "cue",
     "n": 23
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 16,
   "segments": [
    {
     "type": "text",
     "text": "Shut up and sit down"
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Bacchon ek aakhri sawaal. Diwali kyun manaate hain?"
    }
   ]
  },
  {
   "speaker": "ALOK",
   "note": "(Waking up)",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Sir Ram ji Ayodhya waapas laute aur poore Ayodhya mein light chali gayi thi, isliye sabko diye jalaane pade"
    }
   ]
  },
  {
   "speaker": "LAKHAN",
   "note": "(jumping up and down and raising hand)",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Dekha sir!! Us samay bhi yeho samasya thi.. Ye light ka kuchh karna padega.. Main to keh tu jab tak light ki samasya ka samaadhaan nahi milta, homework band kar dena chahiye"
    }
   ]
  },
  {
   "speaker": "KALESHI",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Bilkul, Guruji! Isiliye humne faisla kiya hai..."
    }
   ]
  },
  {
   "speaker": "GURUJI",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Kya?"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "cue",
     "n": 24
    }
   ]
  },
  {
   "speaker": "KALAAM",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Aajse aapki class ki batti gul karke!!"
    }
   ]
  },
  {
   "speaker": "",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "(Lakhan  switches off the classroom light and all students run away.)"
    }
   ]
  },
  {
   "speaker": "NARRATOR",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Toh doston, dekha aapne Guru Gul Paathshaala ke in mahaan vidyarthiyon ka gyaan? Guruji ki koshish jaari hai, aur bachchon ki masti bhi bhaari hai!"
    }
   ]
  },
  {
   "speaker": "NARRATOR",
   "note": "",
   "scene": 17,
   "segments": [
    {
     "type": "text",
     "text": "Aap sabhi ko Diwali ki haardik shubhkaamnaayein! Dhanyavaad!"
    }
   ]
  }
